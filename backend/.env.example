# rMirror Cloud - Environment Configuration Template
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================
# For local development with SQLite (default):
DATABASE_URL=sqlite:///./rmirror.db

# For production with PostgreSQL (comment out DATABASE_URL above and uncomment below):
# POSTGRES_USER=rmirror
# POSTGRES_PASSWORD=your_secure_password_here
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rmirror

# =============================================================================
# REDIS (for background jobs - optional for local dev)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# STORAGE (S3-compatible)
# =============================================================================
# For local development with MinIO:
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=rmirror
S3_REGION=us-east-1

# For production with Hetzner Storage Box or Backblaze B2:
# S3_ENDPOINT_URL=https://s3.eu-central-1.wasabisys.com  # or your provider
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key
# S3_BUCKET_NAME=rmirror-prod
# S3_REGION=eu-central-1

# =============================================================================
# CLAUDE API (for OCR)
# =============================================================================
CLAUDE_API_KEY=sk-ant-api03-your-api-key-here

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# =============================================================================
# CLERK AUTHENTICATION (required in production)
# =============================================================================
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: expected "iss" of Clerk session tokens (default: CLERK_JWKS_URL
# without "/.well-known/jwks.json")
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional, opt-in: accepted "azp" (origin the token was issued for), JSON list.
# Unset (default): azp is not enforced; an azp outside CORS_ORIGINS / DASHBOARD_URL
# is logged once as a warning. Set it (list every dashboard hostname, e.g. apex and
# www) to reject tokens issued for any other origin.
# CLERK_AUTHORIZED_PARTIES=["https://rmirror.example.com"]

# =============================================================================
# TODOIST INTEGRATION (OAuth)
# =============================================================================
# Register app at https://developer.todoist.com/appconsole.html
# TODOIST_CLIENT_ID=your_todoist_client_id
# TODOIST_CLIENT_SECRET=your_todoist_client_secret
# TODOIST_REDIRECT_URI=http://localhost:3000/integrations/todoist/callback

# =============================================================================
# UPLOAD LIMITS (bytes)
# =============================================================================
# MAX_UPLOAD_SIZE=104857600        # PDF/EPUB documents (100 MiB)
# MAX_RM_FILE_SIZE=10485760        # single .rm page file (10 MiB)
# MAX_METADATA_FILE_SIZE=1048576   # .metadata and .content JSON (1 MiB)

# =============================================================================
# APPLICATION
# =============================================================================
DEBUG=false  # Log verbosity only; does not relax security checks

# -----------------------------------------------------------------------------
# INSECURE DEVELOPMENT FLAGS - WARNING: never enable these outside local
# development. The API refuses to start if any is true while DATABASE_URL is
# not SQLite. DEBUG does not relax any security check.
# -----------------------------------------------------------------------------
# ALLOW_UNVERIFIED_CLERK_TOKENS=true  # accept Clerk tokens unverified when CLERK_JWKS_URL is unset
# ALLOW_UNSIGNED_WEBHOOKS=true        # accept Clerk webhooks when CLERK_WEBHOOK_SECRET is unset
# DISABLE_TLS_VERIFY=true             # skip TLS certificate checks on Notion calls

# Receives waitlist signup notifications; if unset, no admin notification is sent
# ADMIN_EMAIL=admin@example.com

# =============================================================================
# RATE LIMITING (defaults shown; see app/middleware/rate_limit.py)
# =============================================================================
# memory:// counts per worker process (effective limit up to N x with N workers)
# RATE_LIMIT_STORAGE_URI=memory://
# RATE_LIMIT_DEFAULT=300/minute
# RATE_LIMIT_UPLOAD=120/minute

# =============================================================================
# SYNC QUEUE RETENTION (defaults shown; pruned by the sync worker about hourly)
# =============================================================================
# Finished sync_queue rows older than this many days are deleted (0 disables).
# Pending/processing rows and sync_records are never pruned.
# SYNC_QUEUE_COMPLETED_RETENTION_DAYS=30
# SYNC_QUEUE_FAILED_RETENTION_DAYS=90
