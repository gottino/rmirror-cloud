# rMirror Cloud backend environment template.
# GENERATED from app/config.py by scripts/generate_env_example.py. Do not edit by hand;
# run `python scripts/generate_env_example.py` after changing Settings.
# Copy to .env. Commented-out variables are optional and unset by default.

# Required
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Application
APP_NAME=rMirror Cloud API
DEBUG=false
API_VERSION=v1

# Database
DATABASE_URL=sqlite:///./rmirror.db
# POSTGRES_USER=rmirror
# POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rmirror

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=redis://localhost:6379/0

# S3/MinIO Storage. Outside debug, local storage needs STORAGE_BACKEND=local.
# STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET_NAME=rmirror
S3_REGION=us-east-1
S3_KEY_PREFIX=

# Google AI API for OCR (Gemini)
# GOOGLE_AI_API_KEY=your-google-ai-api-key
OCR_MODEL=gemini-2.5-flash

# Authentication
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Clerk Authentication (optional - for social login)
# CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
# CLERK_SECRET_KEY=sk_test_your_secret_key
# CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
# CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://localhost:5555", "http://127.0.0.1:5555"]

# File Processing
MAX_UPLOAD_SIZE=104857600
ALLOWED_FILE_TYPES=[".pdf", ".epub"]

# Email Configuration (Resend)
# RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=noreply@rmirror.io
RESEND_FROM_NAME=rMirror Cloud
# ADMIN_EMAIL=admin@example.com

# Notion OAuth Integration
# NOTION_CLIENT_ID=your-notion-client-id
# NOTION_CLIENT_SECRET=your-notion-client-secret
# NOTION_REDIRECT_URI=http://localhost:3000/integrations/notion/callback

# Todoist OAuth Integration
# TODOIST_CLIENT_ID=your-todoist-client-id
# TODOIST_CLIENT_SECRET=your-todoist-client-secret
# TODOIST_REDIRECT_URI=http://localhost:3000/integrations/todoist/callback

# Integration Encryption
# INTEGRATION_MASTER_KEY=generate-with-fernet-generate-key

# Umami Analytics (optional - backend event tracking)
# UMAMI_URL=https://analytics.example.com
# UMAMI_WEBSITE_ID=your-umami-website-id

# Agent Downloads
AGENT_LATEST_VERSION=1.6.0
AGENT_DOWNLOAD_URL_MACOS=

# Beta / Admin
ADMIN_USER_IDS=
INVITE_TOKEN_EXPIRY_DAYS=7
DASHBOARD_URL=https://rmirror.io
BETA_SIGNUP_ENABLED=true

# storage (e.g. redis://...) to make the limits exact across workers.
RATE_LIMIT_STORAGE_URI=memory://

# it is checked before authentication runs).
RATE_LIMIT_DEFAULT=300/minute

# Stricter limits for routes reachable without a dashboard session.
RATE_LIMIT_UNAUTHENTICATED=10/minute
RATE_LIMIT_WEBHOOK=60/minute
RATE_LIMIT_OBSIDIAN_SYNC=60/minute

# work through a large library without stalling while still capping abuse.
RATE_LIMIT_UPLOAD=120/minute
