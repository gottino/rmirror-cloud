# rMirror Cloud - Production Environment Configuration (Hetzner)
# This template is for production deployment on Hetzner VPS

# =============================================================================
# DATABASE - PostgreSQL (Hetzner)
# =============================================================================
# Use PostgreSQL connection string OR individual components (not both)

# Option 1: Full connection string
# DATABASE_URL=postgresql://rmirror:PASSWORD@localhost:5432/rmirror

# Option 2: Individual components (recommended for easier management)
POSTGRES_USER=rmirror
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_HOST=localhost  # Use localhost if PostgreSQL is on same VPS
POSTGRES_PORT=5432
POSTGRES_DB=rmirror

# =============================================================================
# STORAGE - Hetzner Storage Box or Backblaze B2
# =============================================================================
# For Hetzner Storage Box (S3-compatible via WebDAV):
# Note: Hetzner Storage Box requires additional setup for S3 compatibility
# Consider using Backblaze B2 or Wasabi for easier S3-compatible storage

# For Backblaze B2 (recommended - €0.005/GB/month):
# S3_ENDPOINT_URL=https://s3.eu-central-003.backblazeb2.com
# S3_ACCESS_KEY=your_b2_key_id
# S3_SECRET_KEY=your_b2_application_key
# S3_BUCKET_NAME=rmirror-prod
# S3_REGION=eu-central-003

# For Wasabi (fast, S3-compatible):
S3_ENDPOINT_URL=https://s3.eu-central-1.wasabisys.com
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET_NAME=rmirror-prod
S3_REGION=eu-central-1

# =============================================================================
# OCR (Google Gemini)
# =============================================================================
GOOGLE_AI_API_KEY=your-production-google-ai-api-key-here
# Languages the handwriting is expected in, e.g. "German and English".
# Empty (default): any language, the OCR prompt names none.
# OCR_LANGUAGE_HINT=

# =============================================================================
# AUTHENTICATION
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# =============================================================================
# CLERK AUTHENTICATION (required - JWT verification will fail without these)
# =============================================================================
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: expected "iss" of Clerk session tokens (default: CLERK_JWKS_URL
# without "/.well-known/jwks.json")
# CLERK_ISSUER=https://your-app.clerk.accounts.dev
# Optional, opt-in: accepted "azp" (origin the token was issued for), JSON list.
# Unset (default): azp is not enforced; an azp outside CORS_ORIGINS / DASHBOARD_URL
# is logged once as a warning. Set it (list every dashboard hostname, e.g. apex and
# www) to reject tokens issued for any other origin.
# CLERK_AUTHORIZED_PARTIES=["https://rmirror.example.com"]

# =============================================================================
# APPLICATION
# =============================================================================
DEBUG=false

# -----------------------------------------------------------------------------
# INSECURE DEVELOPMENT FLAGS - WARNING: never enable these outside local
# development. The API refuses to start if any is true while DATABASE_URL is
# not SQLite. DEBUG does not relax any security check.
# -----------------------------------------------------------------------------
# ALLOW_UNVERIFIED_CLERK_TOKENS=true  # accept Clerk tokens unverified when CLERK_JWKS_URL is unset
# ALLOW_UNSIGNED_WEBHOOKS=true        # accept Clerk webhooks when CLERK_WEBHOOK_SECRET is unset
# DISABLE_TLS_VERIFY=true             # skip TLS certificate checks on Notion calls
APP_NAME=rMirror Cloud API
API_VERSION=v1

# =============================================================================
# CORS (adjust for your frontend domain)
# =============================================================================
# CORS_ORIGINS=["https://rmirror.yourdomain.com", "https://www.rmirror.yourdomain.com"]
